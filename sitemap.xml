---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Remplace le sitemap généré par jekyll-sitemap (le plugin ne régénère pas s'il trouve
  ce fichier) pour émettre <lastmod> depuis `last_factual_review` — le plugin ne lit
  que `last_modified_at`, absent des fiches. Sélection des pages identique au plugin.
{%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp:'doc','doc.sitemap != false' | where_exp:'doc','doc.url != "/404.html"' %}
{%- for page in pages %}
  <url>
    <loc>{{ page.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
    {%- assign lastmod = page.last_factual_review | default: page.last_modified_at %}
    {%- if lastmod %}
    <lastmod>{{ lastmod | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
